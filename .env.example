# ── uberserver environment config ─────────────────────────────────────────────
# Copy this to .env and fill in your values before running docker-compose up.
# Never commit .env to source control.

# MariaDB credentials
DB_ROOT_PASSWORD=change_me_root
DB_NAME=uberserver
DB_USER=uberserver
DB_PASSWORD=change_me_strong_password

# Ports exposed on the host (change if you have conflicts)
LOBBY_PORT=8200
NAT_PORT=8201

# MaxMind GeoLite2 licence key (free signup at https://www.maxmind.com/en/geolite2/signup)
# Without this, all players will show country code '??'
MAXMIND_LICENSE_KEY=

# Optional. The server's own public IP. Leave blank to auto-detect on startup
# (correct for most setups, and self-corrects on every restart).
#
# This is advertised as the battle host address ONLY for battles hosted from the
# same LAN as the lobby server. Hosts connecting from elsewhere on the internet
# advertise their own WAN IP and are unaffected by this setting.
#
# It is also used to identify the server's own traffic: connections from this
# address skip the registration rate limit and the IPHub VPN check. Setting it to
# an address that is not actually yours grants those exemptions to whoever is.
#
# Only set this if your WAN IP is static, or if outbound HTTPS from the container
# is blocked so auto-detection can't work. A pinned value never self-corrects, so
# do NOT set it on a dynamic/DHCP WAN address.
ONLINE_IP=

# Optional extra arguments passed directly to server.py, e.g.:
# EXTRA_ARGS=--no-censor
EXTRA_ARGS=
